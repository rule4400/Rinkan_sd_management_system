# SQLite データベースの場所
DATABASE_URL="file:./dev.db"

# セッション署名用シークレット（本番では必ずランダムな長い文字列に変更すること）
SESSION_SECRET="change-me-to-a-long-random-string"

# 初期管理者アカウント（seed 実行時に作成される）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"

# チーム共通パスゲート（アプリ層の保護）
# 値を設定すると、アプリ全体が共通パス入力（/gate）で保護される。
# 空（既定）ならゲート無効＝LAN 運用はそのまま。
# インターネット公開時は、これ または Cloudflare Access（推奨）で保護する。
# 詳細は docs/deployment.md を参照。
TEAM_PASSPHRASE=""

# Cookie の Secure 属性の明示制御（任意）
# 未設定（既定）: リクエストが実際に HTTPS（x-forwarded-proto: https）のときだけ Secure を付ける。
#   → LAN の HTTP 運用ではログイン用 Cookie が正しく機能し、Cloudflare 等の HTTPS 経由では Secure になる。
# "true"  : 常に Secure を付ける（独自に常時 HTTPS で配信する場合）
# "false" : 常に付けない（非推奨。検証用途のみ）
COOKIE_SECURE=""
