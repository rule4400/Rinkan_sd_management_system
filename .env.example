# SQLite データベースの場所
DATABASE_URL="file:./dev.db"

# セッション署名用シークレット（本番では必ずランダムな長い文字列に変更すること）
SESSION_SECRET="change-me-to-a-long-random-string"

# 初期管理者アカウント（seed 実行時に作成される）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234"

# インターネット公開時のアプリ全体保護は、ネットワーク層の Cloudflare Access
# （無料 Zero Trust）で行うことを推奨。詳細は docs/system-design.md §9-10 を参照。
